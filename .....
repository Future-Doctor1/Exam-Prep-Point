  <style>
    @import url('https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600&display=swap');

    :root {
      --bg: #f6f8fb;
      --surface: #ffffff;
      --card: #ffffff;
      --border: #e1e7f0;
      --text: #101828;
      --muted: #64748b;
      --radius: 10px;

      --bio: #22c97a;
      --chem: #f97316;
      --phy: #818cf8;
      --eng: #38bdf8;
      --log: #e879f9;

      --cat-chapter: #3b82f6;
      --cat-mock: #f43f5e;
      --cat-quarter: #a78bfa;
      --cat-half: #fb923c;
      --cat-full: #34d399;
      --cat-past: #facc15;
      --cat-speed: #f472b6;
      --cat-concept: #67e8f9;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 200;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0 28px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .topbar-logo {
      font-family: 'Syne', sans-serif;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.5px;
      background: linear-gradient(100deg, #60a5fa 0%, #a78bfa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .topbar-nav {
      display: flex;
      gap: 6px;
    }

    .nav-pill {
      padding: 6px 13px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      cursor: pointer;
      border: none;
      background: transparent;
      font-family: 'Inter', sans-serif;
      text-decoration: none;
      transition: color 0.15s, background 0.15s;
    }

    .nav-pill:hover {
      color: var(--text);
      background: var(--border);
    }

    .hero {
      position: relative;
      padding: 80px 28px 60px;
      text-align: center;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 60% 45% at 50% 0%, rgba(167, 139, 250, 0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-eyebrow {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #60a5fa;
      border: 1px solid rgba(96, 165, 250, 0.3);
      border-radius: 20px;
      padding: 4px 14px;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-family: 'Syne', sans-serif;
      font-size: clamp(32px, 6vw, 58px);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -1.5px;
      margin-bottom: 16px;
    }

    .hero h1 em {
      font-style: normal;
      background: linear-gradient(100deg, #60a5fa 0%, #a78bfa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-sub {
      font-size: 16px;
      color: var(--muted);
      max-width: 500px;
      margin: 0 auto 36px;
      line-height: 1.6;
    }

    .hero-stats {
      display: flex;
      gap: 32px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-stat {
      text-align: center;
    }

    .hero-stat .val {
      font-size: 28px;
      font-weight: 700;
      font-family: 'Syne', sans-serif;
    }

    .hero-stat .lbl {
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .page-body {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px 80px;
    }

    .section {
      margin-bottom: 56px;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 20px;
    }

    .section-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }

    .section-meta h2 {
      font-family: 'Syne', sans-serif;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
      line-height: 1.2;
    }

    .section-meta p {
      font-size: 13px;
      color: var(--muted);
      margin-top: 2px;
    }

    .section-divider {
      height: 1px;
      background: var(--border);
      margin-bottom: 20px;
    }

    .btn-grid-5 {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
    }

    .btn-grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .btn-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .btn-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .test-btn {
      position: relative;
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-left: 3px solid var(--accent-color, #3b82f6);
      border-radius: var(--radius);
      padding: 14px 16px;
      cursor: pointer;
      transition: border-color 0.12s, background 0.12s;
      text-align: left;
      font-family: 'Inter', sans-serif;
      color: var(--text);
      display: flex;
      flex-direction: column;
      gap: 6px;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    }

    .test-btn:hover {
      background: var(--bg);
      border-color: var(--accent-color, #3b82f6);
      border-left-color: var(--accent-color, #3b82f6);
    }

    .btn-emoji {
      font-size: 22px;
      line-height: 1;
    }

    .btn-title {
      font-size: 14px;
      font-weight: 600;
      line-height: 1.3;
    }

    .btn-meta {
      font-size: 11px;
      color: var(--muted);
      line-height: 1.4;
    }

    .btn-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 20px;
      background: rgba(16, 24, 40, 0.06);
      color: var(--muted);
    }

    .badge-new {
      background: rgba(34, 201, 122, 0.15);
      color: var(--bio);
    }

    .badge-hot {
      background: rgba(244, 63, 94, 0.15);
      color: #f43f5e;
    }

    .badge-pro {
      background: rgba(167, 139, 250, 0.15);
      color: #a78bfa;
    }

    .tint-bio {
      --accent-color: var(--bio);
    }

    .tint-chem {
      --accent-color: var(--chem);
    }

    .tint-phy {
      --accent-color: var(--phy);
    }

    .tint-eng {
      --accent-color: var(--eng);
    }

    .tint-log {
      --accent-color: var(--log);
    }

    .tint-chapter {
      --accent-color: var(--cat-chapter);
    }

    .tint-mock {
      --accent-color: var(--cat-mock);
    }

    .tint-quarter {
      --accent-color: var(--cat-quarter);
    }

    .tint-half {
      --accent-color: var(--cat-half);
    }

    .tint-full {
      --accent-color: var(--cat-full);
    }

    .tint-past {
      --accent-color: var(--cat-past);
    }

    .tint-speed {
      --accent-color: var(--cat-speed);
    }

    .tint-concept {
      --accent-color: var(--cat-concept);
    }

    .subject-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .stab {
      padding: 7px 16px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      border: 1.5px solid var(--border);
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }

    .stab-bio {
      --c: var(--bio);
    }

    .stab-chem {
      --c: var(--chem);
    }

    .stab-phy {
      --c: var(--phy);
    }

    .stab-eng {
      --c: var(--eng);
    }

    .stab-log {
      --c: var(--log);
    }

    .stab.active {
      background: var(--c);
      border-color: var(--c);
      color: #fff;
    }

    .stab:not(.active):hover {
      color: var(--c);
      border-color: var(--c);
    }

    .chapter-panel {
      display: none;
    }

    .chapter-panel.active {
      display: grid;
    }

    /* weightage bar */
    .weightage-strip {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      flex-wrap: wrap;
      align-items: center;
    }

    .w-pill {
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: 600;
    }

    .w-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .featured-card {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-left: 3px solid var(--accent-color, var(--cat-mock));
      border-radius: var(--radius);
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 18px;
      cursor: pointer;
      transition: border-color 0.12s, background 0.12s;
      text-decoration: none;
      color: var(--text);
      position: relative;
      --accent-color: var(--cat-mock);
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    }

    .featured-card:hover {
      background: var(--bg);
      border-color: var(--accent-color);
      border-left-color: var(--accent-color);
    }

    .featured-icon {
      font-size: 30px;
      flex-shrink: 0;
    }

    .featured-info {
      flex: 1;
    }

    .featured-info h3 {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .featured-info p {
      font-size: 13px;
      color: var(--muted);
      line-height: 1.5;
    }

    .featured-tag {
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      background: rgba(244, 63, 94, 0.12);
      color: #f43f5e;
      white-space: nowrap;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .year-row {
      display: flex;
      gap: 10px;
      align-items: center;
      padding: 14px 18px;
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 10px;
      transition: border-color 0.15s;
    }

    .year-row:hover {
      border-color: var(--cat-past);
    }

    .year-label {
      font-size: 15px;
      font-weight: 700;
      font-family: 'Syne', sans-serif;
      min-width: 52px;
      color: var(--cat-past);
    }

    .year-btns {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .year-btn {
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      border: 1.5px solid var(--border);
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }

    .year-btn:hover {
      border-color: var(--cat-past);
      color: var(--cat-past);
    }

    .side-rail {
      position: fixed;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 100;
    }

    .rail-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--border);
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      padding: 0;
    }

    .rail-dot:hover,
    .rail-dot.active {
      background: #60a5fa;
      transform: scale(1.5);
    }

    .reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.45s ease, transform 0.45s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: none;
    }

    footer {
      border-top: 1px solid var(--border);
      text-align: center;
      padding: 24px;
      font-size: 13px;
      color: var(--muted);
    }

    @media (max-width: 900px) {
      .btn-grid-5 {
        grid-template-columns: repeat(3, 1fr);
      }

      .btn-grid-4 {
        grid-template-columns: repeat(2, 1fr);
      }

      .featured-grid {
        grid-template-columns: 1fr;
      }

      .side-rail {
        display: none;
      }
    }

    @media (max-width: 600px) {

      .btn-grid-5,
      .btn-grid-4,
      .btn-grid-3 {
        grid-template-columns: repeat(2, 1fr);
      }

      .btn-grid-2 {
        grid-template-columns: 1fr 1fr;
      }

      .hero {
        padding: 50px 18px 40px;
      }

      .topbar {
        padding: 0 16px;
      }

      .page-body {
        padding: 0 14px 60px;
      }

      .hero-stats {
        gap: 20px;
      }

      .topbar-nav {
        display: none;
      }
    }
  </style>
</head>

